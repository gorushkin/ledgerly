meta {
  name: createMultiCurrencyTransaction
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/transactions
  body: json
  auth: bearer
}

headers {
  ~Authorization: {{bearerToken}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "commodityId": "{{commodityId}}",
    "description": "MultiCurrency Transaction",
    "operations": [
      {
        "accountId": "{{rubAccountId}}",
        "amount": "-1000",
        "description": "Spend RUB",
        "value": "-10"
      },
      {
        "accountId": "{{usdAccountId}}",
        "amount": "10",
        "description": "Receive USD",
        "value": "10"
      }
    ],
    "postingDate": "2025-11-07",
    "transactionDate": "2025-11-07"
  }
}
