meta {
  name: update
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/transactions/{{transactionId}}
  body: json
  auth: bearer
}

headers {
  ~Authorization: {{bearerToken}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "description": "updated transaction",
    "operations": {
      "create": [],
      "delete": [],
      "update": [
        {
          "id": "{{operationId1}}",
          "accountId": "{{accountId1}}",
          "amount": "-100",
          "description": "Updated transfer from checking",
          "value": "-100"
        },
        {
          "id": "{{operationId2}}",
          "accountId": "{{accountId2}}",
          "amount": "100",
          "description": "Updated transfer to savings",
          "value": "100"
        }
      ]
    },
    "postingDate": "2025-11-07",
    "transactionDate": "2025-11-07",
    "version": {{transactionVersion}}
  }
}
